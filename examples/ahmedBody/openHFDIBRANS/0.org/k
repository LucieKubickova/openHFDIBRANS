FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.24;

boundaryField
{
    inlet
    {
        type  fixedValue;
        value $internalField;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }

    lowerWall
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    ahmed_bodyGroup
    {
        type            kqRWallFunction;
        value           $internalField;
    }

    wallInsideLambda
    {
	type		zeroGradient;
    }

    upperWall
    {
        type slip;
    }
    
    frontAndBack
    {
        type slip;
    }
}


