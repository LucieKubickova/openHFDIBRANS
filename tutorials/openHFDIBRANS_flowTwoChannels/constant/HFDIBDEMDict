FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      HFDIBDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

surfaceThreshold    1e-4;
sdBasedLambda       false;
// stlName             rectangle;
stlName             geometryOnlyRect;
geomModel           convex;
interfaceSpan       1.0;
saveIntInfo         true;

solidProperties
{
    alpha           8.3333e-6;
    cp              450;
    rho             8000;
}

wallFunctions
{
    U       noSlip;
    T       zeroGradient;
    alphat  alphatJayatillekeWallFunction;
	nut		nutkWallFunction;
	k		kLowReWallFunction;
	omega	omegaWallFunction;
	epsilon	epsilonWallFunction;
}

