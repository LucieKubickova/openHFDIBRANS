FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 0.004898979485566355;

boundaryField
{
    "(inletTop|inletBot)"
    {
        type            fixedValue;
        value           $internalField;
    }

    "(outletTop|outletBot)"
    {
        type            zeroGradient;
    }

    wall
    {
        type            omegaWallFunction;
        value           $internalField;
    }
    
    wallInsideLambda
    {
        type            zeroGradient;
        //~ type            omegaWallFunction;
        //~ value           $internalField;
    }
    
    frontAndBack
    {
        type            empty;
    }
}


