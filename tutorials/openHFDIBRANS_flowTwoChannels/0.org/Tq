FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 1 0 0 0];

internalField   uniform 0.0;

boundaryField
{
    "(inletTop|inletBot)"
    {
        type            zeroGradient;
    }
    
    "(outletTop|outletBot)"
    {
        type            zeroGradient;
    }

    walls
    {
        type            zeroGradient;
    }

    wallInsideLambda
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}

