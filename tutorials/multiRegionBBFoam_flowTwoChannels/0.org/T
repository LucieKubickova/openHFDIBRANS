FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 200.0;

boundaryField
{
    inletTop
    {
        type            fixedValue;
        value           uniform 100.0;
    }
    
    inletBot
    {
        type            fixedValue;
        value           uniform 300.0;
    }
    
    "(outletTop|outletBot|solidLeft|solidRight)"
    {
        type            zeroGradient;
    }

    walls
    {
        type            zeroGradient;
    }

    wallInsideLambda
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}

