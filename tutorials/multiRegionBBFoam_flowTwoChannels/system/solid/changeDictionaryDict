FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

T
{
internalField   uniform 200.0;

boundaryField
{
    inletTop
    {
        type            fixedValue;
        value           uniform 100.0;
    }
    
    inletBot
    {
        type            fixedValue;
        value           uniform 300.0;
    }
    
    "(outletTop|outletBot)"
    {
        type            zeroGradient;
    }

    walls
    {
        type            zeroGradient;
    }

    wallInsideLambda
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }

    solid_to_fluidCold
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     lookup;
        kappa           kappa;
        value           uniform 200;
        verbose         true;
    }

    solid_to_fluidHot
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     lookup;
        kappa           kappa;
        value           uniform 200;
        verbose         true;
    }
}

}


