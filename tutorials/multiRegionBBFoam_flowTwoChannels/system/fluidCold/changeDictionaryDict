FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

U
{
internalField   uniform (0.001 0 0);

boundaryField
{
    "(inletTop|inletBot)"
    {
        type            fixedValue;
        value           $internalField;
    }
    
    "(outletTop|outletBot)"
    {
        type            zeroGradient;
    }

    walls
    {
        type            noSlip;
    }
    
    wallInsideLambda
    {
        type            noSlip;
    }
    
    frontAndBack
    {
        type            empty;
    }

    fluidCold_to_solid
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
}

}

T
{
internalField   uniform 200.0;

boundaryField
{
    inletTop
    {
        type            fixedValue;
        value           uniform 100.0;
    }
    
    inletBot
    {
        type            fixedValue;
        value           uniform 300.0;
    }
    
    "(outletTop|outletBot)"
    {
        type            zeroGradient;
    }

    walls
    {
        type            zeroGradient;
    }

    wallInsideLambda
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }

    fluidCold_to_solid
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     lookup;
        kappa           kappa;
        value           uniform 200;
        verbose         true;
    }
}

}

