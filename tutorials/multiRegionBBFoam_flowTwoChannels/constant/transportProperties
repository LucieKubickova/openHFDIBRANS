//~ //~ beta            3e-03;
//~ beta            0.0;

//~ // Reference temperature
//~ TRef            303; // where beta

//~ // Laminar Prandtl number
//~ Pr              6.666; // for my nu and alpha = 1.5e-7
//~ //~ Pr              7.56; // for water at 18 deg.C
//~ //~ Pr              1e2; // for testing

//~ // Turbulent Prandtl number
//~ Prt             0.85;


